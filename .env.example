# ---- Bailian Managed Agent 凭据（只存在于服务端，绝不下发浏览器）----
BAILIAN_API_KEY=
# 二选一：显式 base_url，或用 workspace_id 推导
BAILIAN_BASE_URL=
BAILIAN_WORKSPACE_ID=

# ---- kit server ----
PORT=8787
KIT_DATA_DIR=.data
# 默认使用内置 SQLite。外部数据库可选 mysql 或 postgres，并填写对应连接地址。
KIT_DB_DRIVER=sqlite
# KIT_DATABASE_URL=mysql://user:password@127.0.0.1:3306/kit
# KIT_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/kit
# 管理端单管理员 bearer token（v1 方案；企业 RBAC/BUC 留后续）
ADMIN_TOKEN=change-me
# macOS / Linux 开发启动留空即使用本地 Keycloak；可显式选 member、oidc 或 anonymous。
KIT_AUTH_MODE=
# 可选：OIDC 模式同时允许 Kit 本地用户名密码登录。
# KIT_OIDC_PASSWORD_LOGIN=true
# 本地 Web 和联动启动的 Keycloak 使用同一个端口。
# KIT_WEB_DEV_PORT=5173
# 接已有 Keycloak 时设置 oidc 并填写三项；member 模式可先在 Console 预绑定成员。
# KIT_OIDC_ISSUER=https://sso.example.com/realms/kit
# KIT_OIDC_CLIENT_ID=kit-web
# KIT_OIDC_AUDIENCE=kit-api
# 可选：Keycloak 使用独立管理域名时，填写对应 Realm 的用户管理页完整链接。
# KIT_KEYCLOAK_USERS_URL="https://sso-admin.example.com/admin/master/console/#/kit/users"
# 本地发行包和 Java 默认按需下载；可覆盖路径，相对路径以仓库根目录为基准。
# KIT_KEYCLOAK_HOME=/path/to/keycloak
# KIT_KEYCLOAK_JAVA_HOME=/path/to/jdk
# 已初始化的本地实例可复用已有管理员文件，内容为 username 和 password。
# KIT_KEYCLOAK_ADMIN_FILE=.scratch/local-keycloak/admin-bootstrap.json
# 可选的可信 JWT 身份扩展；不配置也可使用本地成员登录
KIT_JWT_SECRET=
# 允许跨域的体验页来源，逗号分隔；本地开发默认放行
KIT_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:*
# 可选：跨域部署时的公开服务地址
# KIT_PUBLIC_BASE_URL=
# 可选：追加 admin/auditor 令牌，格式 <token>:<role>，逗号分隔
# KIT_ADMIN_TOKENS=

# ---- 无凭据时的演示模式：用内置 mock gateway 跑通端到端 ----
KIT_GATEWAY=auto

# 评测浏览（console「评测」tab / admin.eval.*）：逗号分隔的 <skill-dir>-workspace 根目录
# KIT_EVAL_WORKSPACES=/path/to/my-skill-workspace,/path/to/other-workspace
