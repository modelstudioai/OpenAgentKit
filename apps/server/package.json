{
  "name": "@openagentpack/kit-server",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAgentKit 服务端：数据面 /api/kit/* 与控制面 /api/admin/*（NestJS + Express + SQLite / MySQL / PostgreSQL）",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "bin": {
    "agents-kit-server": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm db:render && tsup",
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=../../.env dist/bin.js",
    "typecheck": "pnpm db:render && tsc --noEmit",
    "test": "pnpm db:render && vitest run",
    "db:generate": "node --import tsx src/store/migrations/generate.ts",
    "db:check": "node --import tsx src/store/migrations/generate.ts --check",
    "db:render": "node --import tsx src/store/migrations/generate.ts --render",
    "db:entities": "node --import tsx src/store/migrations/generate.ts --entities",
    "gen:openapi": "pnpm db:render && tsx src/openapi.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@openagentkit/sdk": "workspace:*",
    "@openagentpack/kit-eval": "workspace:*",
    "@openagentpack/sdk": "0.10.0",
    "jose": "6.2.18",
    "jszip": "3.10.2",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.3",
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
