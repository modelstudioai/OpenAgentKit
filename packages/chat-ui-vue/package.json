{
	"name": "@openagentpack/kit-chat-ui-vue",
	"version": "0.0.0",
	"private": true,
	"description": "OpenAgentKit Chat 产品 copy-in UI（Vue 3 平行实现）",
	"license": "Apache-2.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme.css": "./src/theme.css",
		"./registry.json": "./registry.json"
	},
	"files": [
		"dist",
		"src",
		"registry.json"
	],
	"scripts": {
		"build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
		"typecheck": "vue-tsc --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"lowlight": "^3.3.0",
		"mermaid": "^11.12.0",
		"rehype-sanitize": "^6.0.0",
		"reka-ui": "^2.11.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5"
	},
	"peerDependencies": {
		"vue": "^3.5.0"
	},
	"devDependencies": {
		"@types/hast": "^3.0.5",
		"@vitejs/plugin-vue": "^6.0.0",
		"@vue/test-utils": "^2.4.6",
		"jsdom": "^30.1.3",
		"typescript": "^5.9.3",
		"vite": "^7.1.9",
		"vitest": "^3.2.4",
		"vue": "^3.5.0",
		"vue-tsc": "^3.0.0"
	}
}
