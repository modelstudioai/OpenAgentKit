{
  "$schema": "https://openagentpack.dev/schema/kit-chat-ui-registry.json",
  "name": "kit-chat-ui",
  "version": 1,
  "usage": "pnpm kit:add <component> 会把组件源码复制进你的项目（copy-in），可自由修改；升级时按 docs 的 diff 指引合并。",
  "components": {
    "layout": {
      "file": "src/components/layout/index.tsx",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/layout/strings.ts"],
      "npmDependencies": ["@radix-ui/react-dialog", "@openagentkit/sdk"]
    },
    "chat": {
      "file": "src/components/chat/index.tsx",
      "deps": ["kit-i18n", "sender", "suggestion", "message", "process-step"],
      "extraFiles": ["src/components/chat/strings.ts"]
    },
    "kit-i18n": { "file": "src/components/kit-i18n/index.ts", "deps": [] },
    "sender": {
      "file": "src/components/sender/index.tsx",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/sender/strings.ts"]
    },
    "attachments": {
      "file": "src/components/attachments/index.tsx",
      "deps": ["kit-i18n", "file-card"],
      "extraFiles": ["src/components/attachments/strings.ts"]
    },
    "suggestion": {
      "file": "src/components/suggestion/index.tsx",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/suggestion/strings.ts"]
    },
    "tooltip": { "file": "src/components/tooltip/index.tsx", "deps": [] },
    "menu": { "file": "src/components/menu/index.tsx", "deps": [], "npmDependencies": ["@radix-ui/react-dropdown-menu"] },
    "message": {
      "file": "src/components/message/index.tsx",
      "deps": ["kit-i18n", "markdown", "actions", "file-card", "execution-group", "reasoning-block", "tool-call-card", "sub-agent-card", "sender", "artifact-card", "message-list", "processing-indicator"],
      "extraFiles": ["src/components/message/strings.ts"]
    },
    "message-anchor-rail": {
      "file": "src/components/message-anchor-rail/index.tsx",
      "deps": ["kit-i18n", "tooltip"],
      "extraFiles": ["src/components/message-anchor-rail/strings.ts"]
    },
    "message-skeleton": {
      "file": "src/components/message-skeleton/index.tsx",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/message-skeleton/strings.ts"]
    },
    "execution-group": {
      "file": "src/components/process/execution-group/index.tsx",
      "deps": ["kit-i18n", "reasoning-block", "tool-call-card"],
      "extraFiles": ["src/components/process/execution-group/strings.ts"]
    },
    "sub-agent-card": {
      "file": "src/components/process/sub-agent-card/index.tsx",
      "deps": ["kit-i18n", "reasoning-block", "tool-call-card", "file-card"],
      "extraFiles": ["src/components/process/sub-agent-card/strings.ts"]
    },
    "sub-agent-panel": {
      "file": "src/components/process/sub-agent-panel/index.tsx",
      "deps": ["kit-i18n", "sub-agent-card"],
      "extraFiles": ["src/components/process/sub-agent-panel/strings.ts"],
      "npmDependencies": ["@radix-ui/react-dialog"]
    },
    "process-step": { "file": "src/components/process/step/index.tsx", "deps": [] },
    "tool-call-card": {
      "file": "src/components/process/tool-call-card/index.tsx",
      "deps": ["kit-i18n", "process-step", "tool-summary", "markdown", "code-highlighter"],
      "extraFiles": ["src/components/process/tool-call-card/strings.ts"]
    },
    "reasoning-block": {
      "file": "src/components/process/reasoning-block/index.tsx",
      "deps": ["kit-i18n", "process-step"],
      "extraFiles": ["src/components/process/reasoning-block/strings.ts"]
    },
    "tool-summary": {
      "file": "src/components/process/tool-summary/index.ts",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/process/tool-summary/strings.ts"]
    },
    "markdown": {
      "file": "src/components/markdown/index.tsx",
      "deps": ["kit-i18n", "code-highlighter", "mermaid"],
      "extraFiles": ["src/components/markdown/strings.ts"]
    },
    "actions": {
      "file": "src/components/actions/index.tsx",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/actions/strings.ts"]
    },
    "file-card": {
      "file": "src/components/file-card/index.tsx",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/file-card/strings.ts"]
    },
    "code-highlighter": {
      "file": "src/components/code-highlighter/index.tsx",
      "deps": ["kit-i18n", "actions"],
      "extraFiles": ["src/components/code-highlighter/strings.ts"]
    },
    "mermaid": {
      "file": "src/components/mermaid/index.tsx",
      "deps": ["kit-i18n", "actions", "code-highlighter"],
      "extraFiles": ["src/components/mermaid/strings.ts"]
    },
    "agent-header": {
      "file": "src/components/agent-header/index.tsx",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/agent-header/strings.ts"]
    },
    "session-list": {
      "file": "src/components/session-list/index.tsx",
      "deps": ["kit-i18n", "tooltip", "process-step"],
      "extraFiles": ["src/components/session-list/strings.ts"]
    },
    "session-sidebar": {
      "file": "src/components/session-sidebar/index.tsx",
      "deps": ["kit-i18n", "session-list", "states"],
      "extraFiles": ["src/components/session-sidebar/strings.ts"]
    },
    "states": { "file": "src/components/states/index.ts", "deps": ["empty-state", "error-state"] },
    "prompts": { "file": "src/components/prompts/index.tsx", "deps": [] },
    "plaza": { "file": "src/components/plaza/index.ts", "deps": ["activity-heatmap", "category-tabs", "meter-bar", "plaza-card"] },
    "tool-approval": { "file": "src/components/tool-approval/index.ts", "deps": ["tool-approval-card", "tool-approval-group"] },
    "chrome": { "file": "src/components/chrome/index.ts", "deps": ["agent-header", "confirm-dialog", "status-indicator", "thread-panel", "states"], "npmDependencies": ["@radix-ui/react-alert-dialog"] },
    "artifact-card": { "file": "src/components/artifact-card/index.tsx", "deps": ["file-card"] },
    "message-list": {
      "file": "src/components/message-list/index.tsx",
      "deps": ["kit-i18n", "message", "message-anchor-rail", "processing-indicator", "sub-agent-card"],
      "extraFiles": ["src/components/message-list/strings.ts"]
    },
    "processing-indicator": {
      "file": "src/components/processing-indicator/index.tsx",
      "deps": ["kit-i18n", "process-step"],
      "extraFiles": ["src/components/processing-indicator/strings.ts"]
    },
    "status-indicator": {
      "file": "src/components/status-indicator/index.tsx",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/status-indicator/strings.ts"]
    },
    "confirm-dialog": {
      "file": "src/components/confirm-dialog/index.tsx",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/confirm-dialog/strings.ts"],
      "npmDependencies": ["@radix-ui/react-alert-dialog"]
    },
    "thread-panel": {
      "file": "src/components/thread-panel/index.tsx",
      "deps": ["kit-i18n", "message"],
      "extraFiles": ["src/components/thread-panel/strings.ts"]
    },
    "empty-state": { "file": "src/components/empty-state/index.tsx", "deps": [] },
    "error-state": {
      "file": "src/components/error-state/index.tsx",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/error-state/strings.ts"]
    },
    "meter-bar": {
      "file": "src/components/meter-bar/index.tsx",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/meter-bar/strings.ts"]
    },
    "activity-heatmap": {
      "file": "src/components/activity-heatmap/index.tsx",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/activity-heatmap/strings.ts"]
    },
    "category-tabs": {
      "file": "src/components/category-tabs/index.tsx",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/category-tabs/strings.ts"]
    },
    "plaza-card": {
      "file": "src/components/plaza-card/index.tsx",
      "deps": ["kit-i18n", "agent-header"],
      "extraFiles": ["src/components/plaza-card/strings.ts"]
    },
    "tool-approval-card": {
      "file": "src/components/tool-approval-card/index.tsx",
      "deps": ["kit-i18n"],
      "extraFiles": ["src/components/tool-approval-card/strings.ts"]
    },
    "tool-approval-group": {
      "file": "src/components/tool-approval-group/index.tsx",
      "deps": ["kit-i18n", "tool-approval-card"],
      "extraFiles": ["src/components/tool-approval-group/strings.ts"]
    }
  },
  "theme": "src/theme.css"
}
